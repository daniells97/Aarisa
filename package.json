    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "nitro": "3.0.260903-beta",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
