# Values live in Infisical. Names only here.
DATABASE_URL=
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
# Service user token for Team access (invites, role changes) and the Aarisa project id.
ZITADEL_SERVICE_TOKEN=
ZITADEL_PROJECT_ID=
ZITADEL_ORG_ID=
# Invites and password resets go out from MAIL_FROM through Resend (domain verified there).
# Without them the owner gets the invite link to share by hand.
RESEND_API_KEY=
MAIL_FROM=
SESSION_SECRET=
N8N_SERVICE_TOKEN=
# WhatsApp is built but off until Aarisa turns it on ("true"); the screens say it is not available yet.
WHATSAPP_ENABLED=
AI_MODEL=
AI_API_KEY=
STT_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
FILE_STORAGE_URL=
# Local folder for imported report files (private volume in production).
FILE_STORAGE_DIR=
APP_BASE_URL=
TZ=America/Los_Angeles
# Local development only: enables /auth/dev role sign-in. Never set in production.
DEV_LOGIN=
