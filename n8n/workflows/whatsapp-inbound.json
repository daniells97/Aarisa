        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "check-verify-token",
      "name": "Check verify token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "jsCode": "const q = $input.first().json.query || {};\nconst ok = q['hub.mode'] === 'subscribe' && q['hub.verify_token'] === $env.WHATSAPP_VERIFY_TOKEN;\nreturn [{ json: { ok, challenge: ok ? q['hub.challenge'] : 'forbidden' } }];"
      }
    },
    {
      "id": "answer-meta",
      "name": "Answer Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        780,
        300
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge }}",
        "options": {
          "responseCode": "={{ $json.ok ? 200 : 403 }}"
        }
      }
    },
    {
      "id": "webhook-messages-post-",
      "name": "Webhook messages (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "aarisa-whatsapp",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "verify-signature-and-read-messages",
      "name": "Verify signature and read messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "jsCode": "// Meta signs the raw body with the app secret (X-Hub-Signature-256). Unsigned or wrong: drop it.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst raw = item.binary?.data ? Buffer.from(item.binary.data.data, 'base64') : Buffer.from(JSON.stringify(item.json.body));\nconst expected = 'sha256=' + crypto.createHmac('sha256', $env.WHATSAPP_APP_SECRET).update(raw).digest('hex');\nconst given = String(item.json.headers?.['x-hub-signature-256'] || '');\nif (given.length !== expected.length || !crypto.timingSafeEqual(Buffer.from(given), Buffer.from(expected))) return [];\nconst body = JSON.parse(raw.toString('utf8'));\nconst out = [];\nfor (const entry of body.entry || []) for (const change of entry.changes || []) for (const m of change.value?.messages || []) {\n  const kind = m.type === 'interactive' || m.type === 'button' ? 'button' : m.type === 'audio' ? 'audio' : m.type === 'text' ? 'text' : 'other';\n  out.push({ json: { waMessageId: m.id, phone: '+' + m.from, kind, text: m.text?.body ?? null,\n    button: m.button?.text ?? m.interactive?.button_reply?.title ?? null, mediaId: m.audio?.id ?? null, date: new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date()) } });\n}\nreturn out;"
      }
    },
    {
      "id": "log-incoming-message",
      "name": "Log incoming message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AARISA_PORTAL_URL }}/api/integrations/messages",
