        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ waMessageId: $json.waMessageId, direction: 'in', phone: $json.phone,\n    type: $json.kind === 'button' ? 'interactive' : $json.kind === 'audio' ? 'audio' : 'text', body: $json.text ?? $json.button, relatedDate: $json.date }) }}"
      },
      "credentials": {
