      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5200,
        300
      ],
      "parameters": {
        "jsCode": "// A refusal or unreadable answer is treated as \"other\": nothing is applied.\nconst msg = $('Build AI request').item.json;\nlet out = { kind: 'other' };\nif ($json.stop_reason !== 'refusal') {\n  const text = ($json.content || []).filter((b) => b.type === 'text').map((b) => b.text).join('');\n  try { out = JSON.parse(text); } catch {}\n}\nreturn [{ json: { ...msg, kind: out.kind, output: out.kind === 'daily_changes' ? out.daily_changes : out.kind === 'extra_job' ? out.extra_job : null, model: $json.model || msg.aiBody.model } }];"
      }
    },
