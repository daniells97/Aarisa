    },
    {
      "id": "who-wrote-and-what-to-do",
      "name": "Who wrote and what to do",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        300
      ],
      "parameters": {
        "jsCode": "// Unknown numbers get a short reply; quick replies skip the AI.\nconst msg = $('Verify signature and read messages').item.json;\nconst logged = $json;\nlet route = 'ai';\nif (!logged.userId) route = 'unknown_number';\nelse if (msg.kind === 'button' && /all good|todo bien/i.test(msg.button || '')) route = 'all_good';\nelse if (msg.kind === 'button') route = 'ask_change';\nelse if (msg.kind === 'audio') route = 'transcribe';\nreturn [{ json: { ...msg, messageId: logged.id, route } }];"
      }
    },
