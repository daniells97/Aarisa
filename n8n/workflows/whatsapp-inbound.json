    {
      "id": "webhook-verify-get-",
      "name": "Webhook verify (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "httpMethod": "GET",
